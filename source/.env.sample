# The PostgreSQL container compose starts, and the database it creates on
# first run. Changing these after that needs `docker compose down -v`, which
# throws the old volume away.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=isp

# Backend. The host is the compose service name; outside Docker (pytest, a
# script on your machine) use localhost:5433, the port compose publishes the
# container on.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/isp

# The MongoDB container, which holds lab equipment. The root user is created
# on first run only, like the POSTGRES_* values above.
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo

# Backend. Host "mongo" inside compose; localhost:27018 from your machine.
MONGO_URL=mongodb://mongo:mongo@mongo:27017/?authSource=admin
MONGO_DB=isp

# Signs the access tokens, so treat it like a password and keep it off the
# frontend. At least 32 characters - generate one with: openssl rand -hex 32
JWT_SECRET=insert_a_generated_secret_here

# How long a login lasts, in minutes. Optional, defaults to 720 (12 hours).
#ACCESS_TOKEN_TTL_MINUTES=720

NEXT_PUBLIC_API_URL=http://localhost:8100

# Production only: comma-separated origins the backend allows via CORS
CORS_ORIGINS=http://localhost:3100

# Production + Cloudflare Tunnel only (used with `--profile tunnel`).
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
# When using the tunnel, also set:
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#   CORS_ORIGINS=https://app.yourdomain.com
TUNNEL_TOKEN=
