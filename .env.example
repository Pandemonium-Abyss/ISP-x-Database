# ---- MySQL (docker-compose maps container 3306 -> host MYSQL_PORT) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3317
MYSQL_DATABASE=labrador
MYSQL_USER=labrador
MYSQL_PASSWORD=labrador_pw
MYSQL_ROOT_PASSWORD=labrador_root

# ---- MongoDB (single-node replica set rs0) ----
MONGO_PORT=27028
MONGO_URI=mongodb://127.0.0.1:27028/labrador?replicaSet=rs0&directConnection=true

# ---- API server ----
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# ---- Docker deployment / Cloudflare Tunnel ----
APP_PORT=4000
# Public URL served by the tunnel, e.g. https://labrador.example.com
PUBLIC_URL=http://localhost:4000
# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel > copy the token
CLOUDFLARE_TUNNEL_TOKEN=
